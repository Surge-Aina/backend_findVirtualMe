  "webhooks": {
    "leadCaptured": {
      "post": {
        "operationId": "leadCaptured",
        "summary": "lead.captured",
        "description": "Sent when a site contact form or inquiry is saved.\nHeaders:\nX-FindVirtualMe-Timestamp is unix seconds.\nX-FindVirtualMe-Signature is v1=<lowercase hex HMAC-SHA256>.\nX-FindVirtualMe-Event is the event id.\nThe HMAC key is the endpoint signing secret.\nThe HMAC message is the UTF-8 string `${timestamp}.${rawBody}` where rawBody is the exact request body.\nReject timestamps more than 300 seconds from the receiver clock.\nCompare the hex digest in constant time.\nDedupe with the JSON id. Retries reuse that id and send a new timestamp.\nDeliveries that are not 2xx are retried with backoff: 5s, 30s, 2m, 10m, 1h, then the delivery stops after 6 attempts.",
        "parameters": [
          {
            "name": "X-FindVirtualMe-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "1760000000"
            }
          },
          {
            "name": "X-FindVirtualMe-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "v1=0123456789abcdef"
            }
          },
          {
            "name": "X-FindVirtualMe-Event",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "evt_example"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadCapturedEvent"
              },
              "example": {
                "id": "evt_example",
                "type": "lead.captured",
                "createdAt": "2026-10-23T12:00:00.000Z",
                "data": {
                  "siteId": "507f1f77bcf86cd799439011",
                  "email": "visitor@example.test",
                  "name": "Visitor Example",
                  "phone": null,
                  "createdAt": "2026-10-23T12:00:00.000Z"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Any 2xx acknowledges the event. Other statuses are retried."
          }
        }
      }
    },
    "sitePublished": {
      "post": {
        "operationId": "sitePublished",
        "summary": "site.published",
        "description": "Sent when a site visibility changes to public. Signature and retry rules match lead.captured.",
        "parameters": [
          {
            "name": "X-FindVirtualMe-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-FindVirtualMe-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-FindVirtualMe-Event",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SitePublishedEvent"
              },
              "example": {
                "id": "evt_example",
                "type": "site.published",
                "createdAt": "2026-10-23T12:00:00.000Z",
                "data": {
                  "siteId": "507f1f77bcf86cd799439011",
                  "publishedAt": "2026-10-23T12:00:00.000Z"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Any 2xx acknowledges the event."
          }
        }
      }
    },
    "businessProfileUpdated": {
      "post": {
        "operationId": "businessProfileUpdated",
        "summary": "business_profile.updated",
        "description": "Sent when a site published business profile changes. Signature and retry rules match lead.captured. FindVirtualMe does not call a third-party API for this change.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BusinessProfileUpdatedEvent"
              },
              "example": {
                "id": "evt_example",
                "createdAt": "2026-10-23T12:00:00.000Z",
                "type": "business_profile.updated",
                "data": {
                  "siteId": "507f1f77bcf86cd799439011",
                  "businessName": "North Clinic",
                  "logoUrl": "https://cdn.example.test/logo.png",
                  "brandColors": {
                    "primary": "#1c1917"
                  },
                  "address": {
                    "line1": "1 Example Street",
                    "city": "Austin",
                    "region": "TX",
                    "postalCode": "78701",
                    "country": "US",
                    "formatted": "1 Example Street, Austin, TX, 78701, US"
                  },
                  "contact": {
                    "email": "desk@example.test",
                    "phone": null,
                    "website": "https://north.example.test"
                  },
                  "updatedAt": "2026-10-23T12:00:00.000Z"
                }
              }
            }
          }
        },
        "responses": {
